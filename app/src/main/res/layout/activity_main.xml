<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    tools:context=".MainActivity">

    <!-- 主体滚动区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="40dp">

            <!-- 1. 页面大标题：网络信息 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="96dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="网络信息"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 2. 核心网络信息卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <!-- IP 地址 -->
                    <TextView
                        android:id="@+id/tvIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:paddingVertical="4dp"
                        android:text="🌐 IP：正在获取..."
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <!-- 归属地 -->
                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:paddingVertical="4dp"
                        android:text="📍 归属地：正在查询..."
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <!-- 运营商 -->
                    <TextView
                        android:id="@+id/tvIsp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:paddingVertical="4dp"
                        android:text="🏢 运营商：--"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <!-- 网络质量行 -->
                    <TextView
                        android:id="@+id/tvQuality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:paddingVertical="4dp"
                        android:text="⭐ 网络质量：检测中..."
                        android:textColor="#388E3C"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="#1AFFFFFF" />

                    <!-- 延迟与网络波动并行展示 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/tvPing"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingVertical="4dp"
                            android:text="⚡ 延迟：--"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvLoss"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingVertical="4dp"
                            android:text="〰️ 波动：--"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- API 数据源 -->
                    <TextView
                        android:id="@+id/tvApiSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:paddingVertical="4dp"
                        android:text="🔗 来源：--"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. 第二个大标题：状态栏设置 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="状态栏设置"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 4. 胶囊按钮区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 第一行：字母 / 国旗 / 网络延迟 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTextMode"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="0dp"
                        android:text="字母"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        app:cornerRadius="48dp"
                        app:elevation="0dp"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFlagMode"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="0dp"
                        android:text="国旗"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        app:cornerRadius="48dp"
                        app:elevation="0dp"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGridMode"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="0dp"
                        android:text="网络延迟"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        app:cornerRadius="48dp"
                        app:elevation="0dp"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- 第二行：网络波动 / 开启服务 / 关闭服务 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- 修改为网络波动 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTextGridMode"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="0dp"
                        android:text="网络波动"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        app:cornerRadius="48dp"
                        app:elevation="0dp"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStart"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="0dp"
                        android:text="开启服务"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        app:backgroundTint="#3B82F6"
                        app:cornerRadius="48dp"
                        app:elevation="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStop"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:paddingHorizontal="0dp"
                        android:text="关闭服务"
                        android:textColor="#94A3B8"
                        android:textSize="18sp"
                        app:cornerRadius="48dp"
                        app:elevation="0dp"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 5. 右下角作者标识 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:text="cf"
        android:textColor="#475569"
        android:textSize="12sp"
        android:textStyle="italic" />

</FrameLayout>
